{
  "toolchain": {
    "qmake": "C:/Qt/6.6.3/msvc2022_64/bin/qmake.exe",
    "jom": "C:/Qt/Tools/QtCreator/bin/jom/jom.exe",
    "vcvars": "C:/Program Files/Microsoft Visual Studio/2022/Professional/VC/Auxiliary/Build/vcvars64.bat",
    "windeployqt": "C:/Qt/6.6.3/msvc2022_64/bin/windeployqt.exe"
  },
  "build": {
    "qmakeArgs": [
      "-spec",
      "win32-msvc",
      "CONFIG+=release"
    ],
    "jomDryRunArgs": [
      "-n"
    ],
    "fallbackMakefiles": [
      "Makefile.Release",
      "Makefile.Debug"
    ],
    "environment": {},
    "skipQmake": false
  },
  "discovery": {
    "ignoreDirs": [
      ".git",
      ".svn",
      ".hg",
      ".vs",
      ".vscode",
      "__pycache__",
      "build",
      "out",
      "reports",
      "release",
      "debug",
      "GeneratedFiles"
    ],
    "ignoreProNames": []
  },
  "analysis": {
    "sourceExtensions": [
      ".c",
      ".cc",
      ".cpp",
      ".cxx"
    ],
    "compileCommands": "",
    "failOnMissingTool": false,
    "clangTidy": {
      "enabled": true,
      "path": "tools/llvm/bin/clang-tidy.exe",
      "jobs": 2,
      "checks": "clang-analyzer-*,bugprone-*,cppcoreguidelines-*,modernize-*,performance-*,portability-*,qt-*,readability-*,-modernize-use-trailing-return-type",
      "extraArgs": [
        "--extra-arg=/std:c++17"
      ],
      "headerFilter": ".*"
    },
    "cppcheck": {
      "enabled": false,
      "path": "tools/cppcheck/cppcheck.exe",
      "enable": "all",
      "inconclusive": true,
      "suppressions": [
        "missingIncludeSystem"
      ],
      "extraArgs": [
        "--inline-suppr"
      ]
    }
  },
  "report": {
    "includeSnippets": true,
    "contextLines": 2,
    "maxIssues": 10000,
    "pathFilters": {
      "includeRoots": [],
      "excludeRoots": [
        "C:/Qt/"
      ]
    },
    "ruleDocs": {
      "paths": [
        "rules/clang-tidy.json",
        "rules/cppcheck.json"
      ]
    }
  }
}
